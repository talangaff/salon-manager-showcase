@model IEnumerable<salon_manager.Models.Client>
@{
    ViewData["Title"] = "Client Colors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Client Colors</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Client</a>
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search by name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No clients found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Colors</th>
                    <th>Toners</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td class="fw-semibold text-nowrap">@client.FirstName @client.LastName</td>
                        <td>
                            @if (client.Colors.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var color in client.Colors)
                                    {
                                        <span class="badge color-badge">@color.Color</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">None</span>
                            }
                        </td>
                        <td>
                            @if (client.Toners.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var toner in client.Toners)
                                    {
                                        <span class="badge toner-badge">@toner.Toner</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">None</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@client.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete @(client.FirstName) @(client.LastName)?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .color-badge {
        background-color: var(--pink-pale);
        color: var(--pink-dark);
        border: 1px solid var(--pink-light);
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.3em 0.65em;
        border-radius: 0.5rem;
    }

    .toner-badge {
        background-color: #f3f0ff;
        color: #6f42c1;
        border: 1px solid #d4c8f7;
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.3em 0.65em;
        border-radius: 0.5rem;
    }
</style>
