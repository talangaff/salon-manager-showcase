@model salon_manager.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<style>
    .pw-card {
        max-width: 440px;
        margin: 2rem auto;
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        overflow: hidden;
    }

    .pw-card-header {
        background: linear-gradient(135deg, #b5166d 0%, #e91e8c 100%);
        padding: 2rem 2rem 1.5rem;
        color: #fff;
    }

    .pw-card-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    .pw-card-header p {
        margin: 0.25rem 0 0;
        opacity: 0.8;
        font-size: 0.9rem;
    }

    .pw-card-body {
        padding: 1.75rem 2rem;
        background: #fff;
    }

    .form-label-styled {
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
        margin-bottom: 0.4rem;
    }

    .btn-save {
        background: linear-gradient(135deg, #b5166d 0%, #e91e8c 100%);
        border: none;
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 1rem;
        padding: 0.75rem;
        transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .btn-save:hover {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .form-control:focus {
        border-color: #e91e8c;
        box-shadow: 0 0 0 0.2rem rgba(233, 30, 140, 0.15);
    }
</style>

<div class="pw-card card">
    <div class="pw-card-header">
        <h2>Change Password</h2>
        <p>You must set a new password before continuing.</p>
    </div>
    <div class="pw-card-body">
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            @if (!(bool)ViewBag.MustChangePassword)
            {
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label-styled"></label>
                    <input asp-for="CurrentPassword" class="form-control" style="border-radius:0.6rem;" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label-styled"></label>
                <input asp-for="NewPassword" class="form-control" style="border-radius:0.6rem;" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label-styled"></label>
                <input asp-for="ConfirmPassword" class="form-control" style="border-radius:0.6rem;" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-save w-100 text-white">Update Password</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
