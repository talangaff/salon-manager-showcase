@model salon_manager.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<style>
    .user-card {
        max-width: 440px;
        margin: 2rem auto;
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        overflow: hidden;
    }

    .user-card-header {
        background: linear-gradient(135deg, #b5166d 0%, #e91e8c 100%);
        padding: 2rem 2rem 1.5rem;
        color: #fff;
    }

    .user-card-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    .user-card-header p {
        margin: 0.25rem 0 0;
        opacity: 0.8;
        font-size: 0.9rem;
    }

    .user-card-body {
        padding: 1.75rem 2rem;
        background: #fff;
    }

    .form-label-styled {
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
        margin-bottom: 0.4rem;
    }

    .btn-save {
        background: linear-gradient(135deg, #b5166d 0%, #e91e8c 100%);
        border: none;
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 1rem;
        padding: 0.75rem;
        transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .btn-save:hover {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .btn-cancel {
        border-radius: 0.75rem;
        font-weight: 600;
        padding: 0.75rem;
        border-color: #dee2e6;
        color: #6c757d;
    }

    .btn-cancel:hover {
        background: #f8f9fa;
        color: #495057;
    }

    .form-control:focus {
        border-color: #e91e8c;
        box-shadow: 0 0 0 0.2rem rgba(233, 30, 140, 0.15);
    }
</style>

<div class="user-card card">
    <div class="user-card-header">
        <h2>Create User</h2>
        <p>The user will be required to change their password on first login.</p>
    </div>
    <div class="user-card-body">
        <form asp-action="CreateUser" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label-styled"></label>
                <input asp-for="Username" class="form-control" style="border-radius:0.6rem;" autocomplete="off" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label-styled"></label>
                <input asp-for="Password" class="form-control" style="border-radius:0.6rem;" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label-styled"></label>
                <input asp-for="ConfirmPassword" class="form-control" style="border-radius:0.6rem;" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-save flex-fill text-white">Create User</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-cancel flex-fill text-center">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
