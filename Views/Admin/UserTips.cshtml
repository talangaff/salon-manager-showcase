@model IEnumerable<salon_manager.Models.Tip>
@{
    ViewData["Title"] = $"{ViewBag.Username}'s Tips";
    string userId = ViewBag.UserId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewBag.Username's Tips</h2>
    <div>
        <a asp-action="UserTotals" asp-route-id="@userId" class="btn btn-outline-secondary">View Totals</a>
        <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to Users</a>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No tips logged yet.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Payment</th>
                <th>Tip Amount</th>
                <th>Total Cash</th>
                <th>Service Cost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tip in Model)
            {
                <tr>
                    <td>@tip.Date.ToString("MM/dd/yyyy")</td>
                    <td>@tip.PaymentMethod</td>
                    <td>@tip.TipAmount.ToString("C")</td>
                    <td>@(tip.TotalCash.HasValue ? tip.TotalCash.Value.ToString("C") : "-")</td>
                    <td>@(tip.ServiceCost.HasValue ? tip.ServiceCost.Value.ToString("C") : "-")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <strong>Total Tips: @Model.Sum(t => t.TipAmount).ToString("C")</strong>
    </div>
}
