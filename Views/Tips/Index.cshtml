@model IEnumerable<salon_manager.Models.Tip>
@{
    ViewData["Title"] = "Tips";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tips</h2>
    <a asp-action="Create" class="btn btn-primary">+ Log Tip</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No tips logged yet.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Payment</th>
                <th>Tip Amount</th>
                <th>Total Cash</th>
                <th>Service Cost</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tip in Model)
            {
                <tr>
                    <td>@tip.Date.ToString("MM/dd/yyyy")</td>
                    <td>@tip.PaymentMethod</td>
                    <td>@tip.TipAmount.ToString("C")</td>
                    <td>@(tip.TotalCash.HasValue ? tip.TotalCash.Value.ToString("C") : "-")</td>
                    <td>@(tip.ServiceCost.HasValue ? tip.ServiceCost.Value.ToString("C") : "-")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@tip.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@tip.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this tip?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <strong>Total Tips: @Model.Sum(t => t.TipAmount).ToString("C")</strong>
    </div>
}
